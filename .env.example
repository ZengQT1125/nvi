# ===== NVIDIA API Gateway 部署配置示例 =====
# 复制为 .env 后按需修改：cp .env.example .env

# 数据加密密钥（至少 32 位，强烈建议改成随机值）
ENCRYPTION_KEY=12345678901234567890123456789012

# 管理后台 Token（强烈建议修改）
ADMIN_TOKEN=zqt1125

# 对外暴露端口（宿主机端口）
BACKEND_PORT=18080
FRONTEND_PORT=14000

# Xray 日志级别: debug / info / warning / error
XRAY_LOG_LEVEL=error