# ===== NVIDIA API Gateway 部署配置示例 =====
# 复制为 .env 后按需修改：cp .env.example .env

# 数据加密密钥（至少 32 位）。以下为默认值，强烈建议改成随机值：
#   openssl rand -hex 16
#   python3 -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=12345678901234567890123456789012

# 管理后台登录 Token（必填，无默认值，请设置高强度随机值）
ADMIN_TOKEN=

# 对外暴露端口（宿主机端口）
BACKEND_PORT=18080
FRONTEND_PORT=14000

# Xray 日志级别: debug / info / warning / error
XRAY_LOG_LEVEL=error