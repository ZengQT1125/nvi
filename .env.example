# ===== NVIDIA API Gateway 部署配置示例 =====
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：ENCRYPTION_KEY 和 ADMIN_TOKEN 没有默认值，必须自己设置。

# 数据加密密钥（至少 32 位），生成方式：
#   openssl rand -hex 16
#   python3 -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=

# 管理后台登录 Token（请设置高强度随机值）
ADMIN_TOKEN=

# 对外暴露端口（宿主机端口）
BACKEND_PORT=18080
FRONTEND_PORT=14000

# Xray 日志级别: debug / info / warning / error
XRAY_LOG_LEVEL=error