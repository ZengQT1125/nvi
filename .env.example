# ===== NVIDIA API Gateway 部署配置示例 =====
# 复制为 .env 后按需修改：cp .env.example .env

# 数据加密密钥（至少 32 位）。以下为默认值，强烈建议改成随机值：
#   openssl rand -hex 16
#   python3 -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=12345678901234567890123456789012

# 管理后台登录 Token（必填，无默认值，请设置高强度随机值）
ADMIN_TOKEN=

# 模型级熔断配置（可选）：
# 某个模型在窗口内 429/5xx 次数超过阈值时，整体熔断该模型一段时间（直接返回 429 快速失败）。
# 阈值过小容易误伤带自动重试的客户端（如 Codex），建议保持默认或设为 0 禁用。
# MODEL_BREAKER_THRESHOLD=50         # 窗口内失败次数阈值（0 = 禁用熔断）
# MODEL_BREAKER_WINDOW_SECONDS=30    # 失败统计窗口（秒）
# MODEL_BREAKER_COOLDOWN_SECONDS=15  # 熔断时长（秒）

# 对外暴露端口（宿主机端口）
BACKEND_PORT=18080
FRONTEND_PORT=14000
